<name>sys_script_include_8831b82bf0c89710b0e43cf86fc0847c</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;global.QuoteApprovalGuard&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;QuoteApprovalGuard&lt;/name&gt;&lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var QuoteApprovalGuard = Class.create();
QuoteApprovalGuard.prototype = {
    initialize: function() {},

    QUOTE_TABLE: 'sn_quote_mgmt_core_quote',

    isQuoteApproval: function(rec) {
        if (!rec)
            return false;
        if (rec.getValue('source_table') == this.QUOTE_TABLE)
            return true;
        var taskId = rec.getValue('sysapproval');
        if (!taskId)
            return false;
        var task = new GlideRecord('task');
        if (!task.get(taskId))
            return false;
        return task.getValue('sys_class_name') == this.QUOTE_TABLE;
    },

    canDecide: function(rec) {
        if (!rec)
            return false;
        if (gs.getUserName() == 'system')
            return true;
        if (gs.hasRole('admin'))
            return true;
        var approverId = rec.getValue('approver');
        if (!approverId)
            return false;
        if (approverId == gs.getUserID())
            return true;
        return this._isActiveApprovalDelegate(approverId);
    },

    canWriteState: function(rec) {
        if (!this.isQuoteApproval(rec))
            return true;
        var state = rec.getValue('state');
        if (state != 'approved' &amp;&amp; state != 'rejected')
            return true;
        return this.canDecide(this._stored(rec));
    },

    canWriteApprover: function(rec) {
        if (!this.isQuoteApproval(rec))
            return true;
        return this.canDecide(this._stored(rec));
    },

    canRead: function(rec) {
        if (!this.isQuoteApproval(rec))
            return true;
        var quoteId = this._quoteId(rec);
        if (!quoteId)
            return false;
        var quote = new GlideRecord(this.QUOTE_TABLE);
        if (!quote.get(quoteId))
            return false;
        return quote.canRead();
    },

    blockUnauthorizedDecision: function(current, previous) {
        if (!this.isQuoteApproval(current))
            return;
        if (this.canDecide(previous))
            return;

        var newState = current.getValue('state');
        var setsOutcome = current.state.changes() &amp;&amp; (newState == 'approved' || newState == 'rejected');
        var movesApprover = current.approver.changes();
        if (!setsOutcome &amp;&amp; !movesApprover)
            return;

        gs.addErrorMessage('Nur der eingetragene Genehmiger darf diese Genehmigung genehmigen oder ablehnen.');
        current.setAbortAction(true);
    },

    _quoteId: function(rec) {
        if (rec.getValue('source_table') == this.QUOTE_TABLE &amp;&amp; rec.getValue('document_id'))
            return rec.getValue('document_id');
        return rec.getValue('sysapproval');
    },

    _stored: function(rec) {
        var stored = new GlideRecord('sysapproval_approver');
        if (stored.get(rec.getUniqueValue()))
            return stored;
        return rec;
    },

    _isActiveApprovalDelegate: function(approverId) {
        var now = new GlideDateTime();
        var del = new GlideRecord('sys_user_delegate');
        del.addQuery('user', approverId);
        del.addQuery('delegate', gs.getUserID());
        del.addQuery('approvals', true);
        del.query();
        while (del.next()) {
            var starts = del.getValue('starts');
            if (starts) {
                var startAt = new GlideDateTime(starts);
                if (startAt.compareTo(now) &gt; 0)
                    continue;
            }
            var ends = del.getValue('ends');
            if (ends) {
                var endAt = new GlideDateTime(ends);
                if (endAt.compareTo(now) &lt; 0)
                    continue;
            }
            return true;
        }
        return false;
    },

    type: 'QuoteApprovalGuard'
};]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;IZEAE65&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-10-26 10:06:22&lt;/sys_created_on&gt;&lt;sys_id&gt;8831b82bf0c89710b0e43cf86fc0847c&lt;/sys_id&gt;&lt;sys_mod_count&gt;3&lt;/sys_mod_count&gt;&lt;sys_name&gt;QuoteApprovalGuard&lt;/sys_name&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_8831b82bf0c89710b0e43cf86fc0847c&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;IZEAE65&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-10-27 11:38:02&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;8831b82bf0c89710b0e43cf86fc0847c&lt;/id&gt;&lt;sys_created_by&gt;IZEAE65&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-10-26 10:06:22&lt;/sys_created_on&gt;&lt;sys_id&gt;3b433cabf0c89710b0e43cf86fc08409&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;IZEAE65&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-10-26 10:06:22&lt;/sys_updated_on&gt;&lt;table&gt;sys_script_include&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
