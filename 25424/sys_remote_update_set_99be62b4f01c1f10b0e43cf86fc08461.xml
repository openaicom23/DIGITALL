<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;false&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;true&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;sn_quote_mgmt_core_quote&lt;/collection&gt;&lt;condition/&gt;&lt;description&gt;Notify Presales on KAM approval&lt;/description&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="sn_quote_mgmt_core_quote"&gt;stateCHANGESTOapproved^EQ&lt;item display_value="Approved" endquery="false" field="state" goto="false" newquery="false" operator="CHANGESTO" or="false" value="approved"/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;Notify Presales on KAM approval&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous) {
       var contactGr = new GlideRecord('sn_quote_mgmt_core_quote_internal_contact');
       contactGr.addQuery('u_quote', current.getUniqueValue());
       contactGr.addQuery('u_rolle', 'Presales Consultant');
       contactGr.setLimit(1);
       contactGr.query();
       if (!contactGr.next())
           return;
       var userId = contactGr.getValue('u_user');
       if (!userId)
           return;
       gs.eventQueue('sn_quote_mgmt_core.quote.kam_approved', current, userId);
   })(current, previous);]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;IZEAE65&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-10-30 16:02:14&lt;/sys_created_on&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path/&gt;&lt;sys_id&gt;449a26b0f01c1f10b0e43cf86fc08445&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_name&gt;Notify Presales on KAM approval&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Quote Management Data Model" source="sn_quote_mgmt_core"&gt;d5457076b70131101aaebe508e11a907&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Quote Management Data Model"&gt;d5457076b70131101aaebe508e11a907&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_449a26b0f01c1f10b0e43cf86fc08445&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;IZEAE65&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-10-30 16:02:14&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;after&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=449a26b0f01c1f10b0e43cf86fc08445"/&gt;&lt;/record_update&gt;</payload>
